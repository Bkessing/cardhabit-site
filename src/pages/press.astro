---
import { storeLink } from '../lib/storeLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Ornament from '../components/Ornament.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'CardHabit Press Kit';
const description = 'Press kit for CardHabit, a card-based daily challenge for iOS. Positioning, founder story, key facts, screenshots, and contact. Available now on the App Store.';

const facts = [
  ['Name', 'CardHabit'],
  ['Category', 'Lifestyle / habits'],
  ['Platform', 'iOS (iPhone), iOS 18 and later'],
  ['Launch', 'July 13, 2026. Live on the App Store now.'],
  ['App Store', 'apps.apple.com/us/app/cardhabit-tcg-habit-tracker/id6768107296'],
  ['App Store ID', '6768107296. Exact listing title: CardHabit: TCG Habit Tracker.'],
  ['Price', 'Free to start. Pro at founder pricing: $4.99/month or $39.99/year, with a 7-day free trial.'],
  ['Developer', 'Brandon Kessinger (solo)'],
  ['Location', 'Phoenix, Arizona'],
  ['At launch', 'App Intents for Siri and Shortcuts, Sign in with Apple, Family Sharing on subscriptions, no third-party tracking.'],
];

const labelStyle = "font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#6E1E22;";
const bodyStyle = "font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:1.05rem;line-height:1.7;color:#574B40;";
const h2Style = "font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(1.8rem,5vw,2.5rem);line-height:1.1;letter-spacing:-0.01em;color:#2B211B;margin:0 0 1.5rem;";
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main>
    <!-- Header -->
    <section style="padding:4.5rem 1.5rem 2.5rem;text-align:center;">
      <div style="max-width:680px;margin:0 auto;">
        <p style={labelStyle + 'margin:0 0 1.25rem;'}>Press kit</p>
        <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2.2rem,7vw,3.5rem);line-height:1.05;letter-spacing:-0.015em;color:#2B211B;margin:0 0 1.25rem;">
          CardHabit <em style="color:#6E1E22;font-style:italic;">press kit.</em>
        </h1>
        <p style={bodyStyle + 'max-width:560px;margin:0 auto;'}>
          Everything you need to write about CardHabit. Lift any of it. For anything else, the developer answers email directly.
        </p>
      </div>
    </section>

    <!-- Boilerplate: the on-domain entity home. Lift verbatim. -->
    <section style="padding:2.5rem 1.5rem;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style}>About CardHabit</h2>
        <div style="border-left:2px solid rgba(156, 122, 46, 0.4);padding-left:1.25rem;">
          <p style={bodyStyle + 'margin:0 0 1.25rem;'}>
            CardHabit is an iOS daily challenge app built on trading-card-game mechanics: every morning it deals you five habit cards, and you commit to what you can handle that day. Every card you finish goes into your binder, a collection that grows with each day you show up, and rarer cards carry a richer printed finish, from plain to full gold foil. CardHabit 2.0 brings a luxury playing-card deck with five suits (Physical, Mind, Nutrition, Recovery, and Connection) plus the Joker, and Deal a friend in: you send a card from your hand into a friend's hand for today, and if you both finish it, you each get a paired foil card with both names on it. CardHabit is free on iOS with a premium tier. It launched in July 2026 and is built by solo developer Brandon Kessinger.
          </p>
          <p style={bodyStyle + 'margin:0;'}>
            CardHabit lives at cardhabitapp.com. It is not affiliated with cardhabit.com, and it is not the Habit Card app, a tile-grid tracker for Android. The App Store listing is CardHabit: TCG Habit Tracker (id 6768107296).
          </p>
        </div>
      </div>
    </section>

    <!-- The pitch -->
    <section style="padding:2.5rem 1.5rem;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style}>The short version</h2>
        <p style={bodyStyle + 'margin:0 0 1.25rem;'}>
          CardHabit is a daily card draw for your life. Every morning it deals you five habit cards, and you commit to what you can handle before your day starts. Finished cards fill your binder; rank and XP sit quietly underneath. With 2.0, you can deal a friend in on any card in your hand, and finishing it together earns you both a paired foil card. Nothing bad happens if one of you doesn't finish. The social side is designed for small groups of friends, not viral networks.
        </p>
        <p style={bodyStyle + 'margin:0;'}>
          The audience is people who read Atomic Habits, burned out on 75 Hard, and now want something hard every day instead of extreme once. You don't pick what to track, only whether you show up. The look of a luxury playing-card deck (cream card stock, a gold foil card back, a linen table, fine line-art) positions it as the quiet-intensity counter to all-or-nothing fitness culture.
        </p>
      </div>
    </section>

    <!-- Founder -->
    <section style="padding:2.5rem 1.5rem;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style}>The developer</h2>
        <p style={bodyStyle + 'margin:0;'}>
          CardHabit is built by Brandon Kessinger, a solo developer in Phoenix, Arizona. He shipped it on roughly an hour a day, building in public to a July 2026 App Store launch. The constraint shaped the product: scoped cards small enough to do every morning, a system that survives missed days, and a thesis that persistence beats grind.
        </p>
      </div>
    </section>

    <!-- Key facts -->
    <section style="padding:2.5rem 1.5rem;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style}>Key facts</h2>
        <dl style="margin:0;display:grid;grid-template-columns:1fr;gap:0;">
          {facts.map(([k, v]) => (
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem 1.5rem;padding:0.9rem 0;border-bottom:0.5px solid rgba(156, 122, 46, 0.15);">
              <dt style={labelStyle + 'flex:0 0 120px;padding-top:3px;'}>{k}</dt>
              <dd style={bodyStyle + 'flex:1;min-width:200px;margin:0;font-size:1rem;'}>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!--
      Screenshots: hidden pending recapture. The 2026-09-27 retheme
      (light parchment/sienna, replacing the old dark-and-gold app UI) landed
      in the app after these device screenshots were taken, so the grid below
      would show stale dark-theme frames next to the new light copy above.
      Recapture from the redesigned app and restore the `shots` grid before
      shipping this section again.
    -->
    <section style="padding:2.5rem 1.5rem;text-align:center;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style + 'text-align:center;'}>Screenshots</h2>
        <p style={bodyStyle}>
          Fresh device screenshots of the current build are on the way. For a set today, email us and we'll send the latest.
        </p>
      </div>
    </section>

    <!-- Brand -->
    <section style="padding:2.5rem 1.5rem;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style}>Brand</h2>
        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
          <img src="/press/app-icon.png" alt="CardHabit app icon" width="88" style="width:88px;height:88px;border-radius:20px;border:1px solid rgba(156, 122, 46, 0.3);" />
          <div style={bodyStyle + 'flex:1;min-width:240px;font-size:1rem;'}>
            Wordmark: CardHabit, one word, set in Cinzel capitals. Typefaces: Cinzel (titles), Cormorant Garamond (flavor text) and Jost (interface). Look: a luxury playing-card deck, cream card stock <span style="color:#6E1E22;">#F4EDE0</span>, warm ink <span style="color:#6E1E22;">#2B211B</span>, an oxblood card back <span style="color:#6E1E22;">#6E1E22</span> with gold foil <span style="color:#6E1E22;">#B08A3E</span>.
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section style="padding:2.5rem 1.5rem 4rem;text-align:center;">
      <div style="max-width:680px;margin:0 auto;">
        <h2 style={h2Style + 'text-align:center;'}>Contact</h2>
        <p style={bodyStyle + 'margin:0 0 1.5rem;'}>
          Brandon Kessinger answers press email directly, usually same day.
        </p>
        <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:1.5rem;">
          <a href={storeLink('cardhabit-site')} data-appstore-cta="press" style="font-family:'Jost',system-ui,sans-serif;font-size:13px;font-weight:500;letter-spacing:0.08em;color:#6E1E22;text-decoration:none;">Download on the App Store</a>
          <a href="mailto:hello@cardhabitapp.com" style="font-family:'Jost',system-ui,sans-serif;font-size:13px;font-weight:500;letter-spacing:0.08em;color:#6E1E22;text-decoration:none;">hello@cardhabitapp.com</a>
          <a href="https://x.com/KessingerBuilds" target="_blank" rel="noopener" style="font-family:'Jost',system-ui,sans-serif;font-size:13px;font-weight:500;letter-spacing:0.08em;color:#6E1E22;text-decoration:none;">@KessingerBuilds</a>
          <a href="https://cardhabitapp.com" style="font-family:'Jost',system-ui,sans-serif;font-size:13px;font-weight:500;letter-spacing:0.08em;color:#6E1E22;text-decoration:none;">cardhabitapp.com</a>
        </div>
      </div>
    </section>
    <Ornament />
  </main>
  <SiteFooter />
</BaseLayout>
