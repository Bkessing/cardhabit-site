---
// URL kept on purpose (/archetypes is indexed and linked). The page now
// explains the five suits plus the Joker, which replaced the old play-style
// system on 2026-11-10 (brain CardHabit Decisions).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Ornament from '../components/Ornament.astro';
import Suits from '../components/Suits.astro';
import SuitPip from '../components/SuitPip.astro';
import GetTheApp from '../components/GetTheApp.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SUITS, SUIT_ORDER } from '../lib/suits';

const title = 'The Five Suits: Physical, Mind, Nutrition, Recovery, Connection and the Joker | CardHabit';
const description = 'Every CardHabit card belongs to one of five suits, Physical, Mind, Nutrition, Recovery and Connection, plus the Joker. Each suit has its own symbol and ink, and your binder shows your strongest suit.';

const detail: Record<string, string> = {
  physical: 'Cards that ask your body for something: a set of push-ups, a walk with no destination, twenty flights of stairs. Scoped small enough to do on a busy day, real enough to feel.',
  mind: 'Reading, writing and focus. Fifty pages of a real book, a paragraph by hand, an hour without switching tabs. The suit for attention.',
  nutrition: 'Eating on purpose rather than by default. Cook one meal yourself, eat a real breakfast, drink water before the first coffee.',
  recovery: 'Rest that counts as work. Phone down an hour before bed, five minutes of silence, a cold shower. The suit most people skip and most need.',
  connection: 'Cards that point at other people: call someone you have been meaning to call, give something away, say the honest sentence out loud. Warm, never performative.',
  joker: 'The wild cards. The base deck holds two true Jokers, and every pack carries one more. A Joker asks for something you would not have picked, like doing the opposite of one default today.',
};
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main>
    <section style="padding:4.5rem 1.5rem 2.5rem;text-align:center;">
      <div style="max-width:780px;margin:0 auto;">
        <p class="z-eyebrow">The deck</p>
        <h1 style="font-size:clamp(2.2rem,6.5vw,3.5rem);line-height:1.08;color:#2B211B;margin:0 0 1.5rem;">
          The five <em>suits.</em>
        </h1>
        <p style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.3rem;line-height:1.55;color:#3E342B;max-width:640px;margin:0 auto;">
          A playing-card deck has suits, and so does CardHabit. Every card belongs to one of five, Physical, Mind, Nutrition, Recovery and Connection, plus the Joker. The suit tells you what kind of day the card asks for. It never changes, and it never locks you out of anything.
        </p>
      </div>
    </section>

    <Suits bare />

    <section class="section-pad" style="padding-left:1.5rem;padding-right:1.5rem;">
      <div style="max-width:780px;margin:0 auto;">
        <h2 style="font-size:clamp(1.6rem,4.5vw,2.25rem);line-height:1.12;color:#2B211B;margin:0 0 2rem;text-align:center;">
          What each suit <em>asks of you.</em>
        </h2>
        {SUIT_ORDER.map((k, i) => (
          <div style={`display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem 0;${i > 0 ? 'border-top:1px solid rgba(176,138,62,0.35);' : ''}`}>
            <div style="padding-top:4px;"><SuitPip suit={k} size={26} /></div>
            <div>
              <h3 style={`font-size:1.3rem;color:${SUITS[k].ink};margin:0 0 0.4rem;`}>{SUITS[k].name}</h3>
              <p style="font-weight:300;font-size:1rem;line-height:1.75;color:#574B40;margin:0;">{detail[k]}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <Ornament />

    <section class="section-pad" style="padding-left:1.5rem;padding-right:1.5rem;">
      <div style="max-width:780px;margin:0 auto;font-weight:300;font-size:1rem;line-height:1.75;color:#574B40;">
        <h2 style="font-size:clamp(1.6rem,4.5vw,2.25rem);line-height:1.12;color:#2B211B;margin:0 0 1.25rem;text-align:center;">
          Your strongest <em>suit.</em>
        </h2>
        <p style="margin:0 0 1rem;">Every card you finish goes into your binder, and the binder counts by suit. Your strongest suit is simply the one you have finished most, for example "Mind, 42 cards". It comes with no perks and no penalties. It is a mirror: the part of your life you actually show up for, measured in cards rather than intentions.</p>
        <p style="margin:0;">Each card also carries a finish. Most are plain card stock, rarer cards carry a foil edge, and the rarest come in full gold foil. The suit says what kind of card it is; the finish says how rare.</p>
      </div>
    </section>

    <Ornament />

    <GetTheApp source="suits" />
  </main>
  <SiteFooter />
</BaseLayout>
