---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Suits from '../components/Suits.astro';
import DealIn from '../components/DealIn.astro';
import Binder from '../components/Binder.astro';
import PrintedDeck from '../components/PrintedDeck.astro';
import Ornament from '../components/Ornament.astro';
import WhereFrom from '../components/WhereFrom.astro';
import Faq from '../components/Faq.astro';
import GetTheApp from '../components/GetTheApp.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
  <Nav />
  <main>
    <ComingSoon />
    <Hero />
    <HowItWorks />
    <Suits />
    <DealIn />
    <Ornament />
    <Binder />
    <PrintedDeck />
    <WhereFrom />
    <Ornament />
    <Faq variant="subset" />
    <Ornament />
    <GetTheApp />
  </main>
  <SiteFooter />
</BaseLayout>
