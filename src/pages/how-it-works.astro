---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Ornament from '../components/Ornament.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GetTheApp from '../components/GetTheApp.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'How CardHabit Works: Four Small Cards, Dealt Every Morning';
const description = 'How CardHabit works: every morning the iOS app deals you four small habit cards. Keep what you can handle, redraw a card you cannot, hold a card to finish it, and every finished card goes into your binder.';
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main>
    <!-- Page hero -->
    <section style="padding:5rem 1.5rem 3rem;text-align:center;">
      <div style="max-width:780px;margin:0 auto;">
        <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#6E1E22;margin:0 0 1.25rem;">
          The daily draw
        </p>
        <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2.4rem,7vw,3.75rem);line-height:1.04;letter-spacing:-0.015em;color:#2B211B;margin:0 0 1.75rem;">
          How CardHabit <em style="color:#6E1E22;font-style:italic;">works.</em>
        </h1>
        <p style="font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:1.05rem;line-height:1.7;color:#574B40;max-width:620px;margin:0 auto;">
          CardHabit is a daily card draw for your life, not a checkbox tracker: you don't write your own habit list, the app deals one to you. Every morning you are dealt four small habit cards, and the whole hand fits on one screen. Keep what you can handle, redraw a card you cannot, and hold a card to finish it. A day counts when you finish one card, and finishing every card you kept is a clean hand. A Stoic line from Marcus Aurelius, Seneca or Epictetus sits under every hand, with its source one tap away. The deck has five suits (Physical, Mind, Nutrition, Recovery and Connection) plus the Jokers, and you can build it yourself: set a suit aside, or shuffle packs in or out. Every finished card is kept in your binder, suit by suit, and finishing a card again raises it from bronze to silver to gold.
        </p>
      </div>
    </section>

    <Ornament />

    <HowItWorks />

    <Ornament />

    <!-- Cross-links -->
    <section style="padding:4rem 1.5rem;text-align:center;">
      <div style="max-width:680px;margin:0 auto;">
        <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#6E1E22;margin:0 0 1.5rem;">
          Keep reading
        </p>
        <p style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:1.25rem;line-height:1.6;color:#574B40;margin:0;">
          <a href="/archetypes" style="color:#6E1E22;text-decoration:none;border-bottom:0.5px solid rgba(156, 122, 46, 0.4);">The deck and its suits</a> &nbsp;·&nbsp; <a href="/faq" style="color:#6E1E22;text-decoration:none;border-bottom:0.5px solid rgba(156, 122, 46, 0.4);">Frequently asked questions</a>
        </p>
      </div>
    </section>

    <Ornament />

    <GetTheApp />
  </main>
  <SiteFooter />
</BaseLayout>
