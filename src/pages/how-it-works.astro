---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Ornament from '../components/Ornament.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GetTheApp from '../components/GetTheApp.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'How CardHabit Works: Five Cards, Dealt Every Morning';
const description = 'How CardHabit works: every morning the iOS app deals you five habit cards. You commit to what you can handle, hold to complete, and every finished card fills your binder. CardHabit 2.0 adds five suits and lets you deal a friend in.';
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main>
    <!-- Page hero -->
    <section style="padding:5rem 1.5rem 3rem;text-align:center;">
      <div style="max-width:780px;margin:0 auto;">
        <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#6E1E22;margin:0 0 1.25rem;">
          The daily draw
        </p>
        <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2.4rem,7vw,3.75rem);line-height:1.04;letter-spacing:-0.015em;color:#2B211B;margin:0 0 1.75rem;">
          How CardHabit <em style="color:#6E1E22;font-style:italic;">works.</em>
        </h1>
        <p style="font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:1.05rem;line-height:1.7;color:#574B40;max-width:620px;margin:0 auto;">
          CardHabit is a daily card draw for your life, not a checkbox tracker: you don't write your own habit list, the app deals one to you. Every morning you are dealt five habit cards. You look at the hand, commit to the cards you can handle that day, and hold each one down for a second and a half when you complete it. Every finished card goes into your binder, the collection the app calls the Codex, and rarer cards carry a richer printed finish, from plain to a foil edge to full gold foil. CardHabit 2.0 brings the full deck, with five suits (Physical, Mind, Nutrition, Recovery, and Connection) plus the Joker, and a way to deal a friend in: send the same card into their hand for today, and if you both finish it, you each get a paired foil card with both names on it.
        </p>
      </div>
    </section>

    <Ornament />

    <HowItWorks />

    <Ornament />

    <!-- Cross-links -->
    <section style="padding:4rem 1.5rem;text-align:center;">
      <div style="max-width:680px;margin:0 auto;">
        <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#6E1E22;margin:0 0 1.5rem;">
          Keep reading
        </p>
        <p style="font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:1.25rem;line-height:1.6;color:#574B40;margin:0;">
          <a href="/archetypes" style="color:#6E1E22;text-decoration:none;border-bottom:0.5px solid rgba(156, 122, 46, 0.4);">The deck and its suits</a> &nbsp;·&nbsp; <a href="/faq" style="color:#6E1E22;text-decoration:none;border-bottom:0.5px solid rgba(156, 122, 46, 0.4);">Frequently asked questions</a>
        </p>
      </div>
    </section>

    <Ornament />

    <GetTheApp />
  </main>
  <SiteFooter />
</BaseLayout>
