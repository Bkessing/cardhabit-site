---
// A slim "2.0 coming soon" band under the nav (Brandon, 2026-11-12, hq #164).
// No date, no packs, no prices, no hand size. One line on a phone: the second
// sentence drops below 520px wide so the band never wraps.
---

<aside class="soon" aria-label="CardHabit 2.0">
  <span class="soon-pip" aria-hidden="true"></span>
  <p class="soon-text">
    CardHabit 2.0 is coming soon.<span class="soon-more"> A new deck, a new daily draw.</span>
  </p>
  <span class="soon-pip" aria-hidden="true"></span>
</aside>

<style>
  .soon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 9px 1rem;
    background: #F8F3E8;
    border-bottom: 1px solid rgba(176, 138, 62, 0.35);
    box-shadow: inset 0 -3px 0 -2px rgba(217, 188, 116, 0.5);
  }
  .soon-text {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.3;
    color: #3E342B;
    white-space: nowrap;
  }
  /* A tiny gold-foil diamond either side, like the card back's corner pips. */
  .soon-pip {
    flex: none;
    width: 6px;
    height: 6px;
    transform: rotate(45deg);
    background: linear-gradient(135deg, #E6CF8E, #B08A3E);
  }
  @media (max-width: 520px) {
    .soon-more { display: none; }
  }
</style>
