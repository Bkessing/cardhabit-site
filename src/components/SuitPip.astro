---
// Suit symbols as simple engraved glyphs, drawn in the suit's own ink.
import { SUITS, type Suit } from '../lib/suits';

interface Props {
  suit: Suit;
  size?: number;
  color?: string;
}

const { suit, size = 18, color } = Astro.props;
const ink = color ?? SUITS[suit].ink;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:inline-block;flex:none;">
  {suit === 'physical' && (
    <>
      <path d="M2.5 20.5 L9.5 7 L13 13.2 L15.6 9.4 L21.5 20.5 Z" fill={ink} />
      <path d="M8.1 9.7 L9.5 7 L10.9 9.5 L9.9 9 L9.1 10 Z" fill="#F4EDE0" opacity="0.85" />
    </>
  )}
  {suit === 'mind' && (
    <>
      <path d="M12 6.5 C9.5 5 6 4.6 2.5 5.2 V18.4 C6 17.8 9.5 18.3 12 19.8 Z" fill={ink} />
      <path d="M12 6.5 C14.5 5 18 4.6 21.5 5.2 V18.4 C18 17.8 14.5 18.3 12 19.8 Z" fill={ink} opacity="0.78" />
    </>
  )}
  {suit === 'nutrition' && (
    <>
      <path d="M4 20 C4 11 9 4.5 20.5 3.5 C20 14 14 20 4 20 Z" fill={ink} />
      <path d="M5 19 C9 15 12.5 11.5 17 6.5" stroke="#F4EDE0" stroke-width="1.1" stroke-linecap="round" />
    </>
  )}
  {suit === 'recovery' && (
    <path d="M15.5 3.2 A9 9 0 1 0 20.8 15.6 A7.2 7.2 0 0 1 15.5 3.2 Z" fill={ink} />
  )}
  {suit === 'connection' && (
    <>
      <circle cx="9" cy="12" r="5.6" stroke={ink} stroke-width="2.4" />
      <circle cx="15" cy="12" r="5.6" stroke={ink} stroke-width="2.4" />
    </>
  )}
  {suit === 'joker' && (
    <path d="M12 1.8 L13.6 8.1 L19.2 4.8 L15.9 10.4 L22.2 12 L15.9 13.6 L19.2 19.2 L13.6 15.9 L12 22.2 L10.4 15.9 L4.8 19.2 L8.1 13.6 L1.8 12 L8.1 10.4 L4.8 4.8 L10.4 8.1 Z" fill={ink} />
  )}
</svg>
