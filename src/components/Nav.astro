---
import { storeLink } from '../lib/storeLink';
---

<nav style="position:sticky;top:0;z-index:100;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);background:rgba(242, 235, 221, 0.9);border-bottom:1px solid rgba(176, 138, 62, 0.35);">
  <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;height:58px;display:flex;align-items:center;justify-content:space-between;">
    <!-- Wordmark: the deck's card back plus Cinzel capitals, as on the tuck box -->
    <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
      <img src="/z/card-back.webp" alt="" width="18" height="27" style="width:18px;height:27px;border-radius:2px;box-shadow:0 1px 2px rgba(43,33,27,0.25);" />
      <span style="font-family:'Cinzel',Georgia,serif;font-size:19px;color:#2B211B;letter-spacing:0.14em;">CARDHABIT</span>
    </a>

    <a
      href={storeLink('cardhabit-site')}
      class="nav-store-btn"
      data-appstore-cta="nav"
      style="font-family:'Jost',system-ui,sans-serif;font-size:12px;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:#6E1E22;border:1px solid rgba(110, 30, 34, 0.45);border-radius:4px;padding:7px 14px;text-decoration:none;transition:background 0.2s,color 0.2s;"
    >
      Get the app
    </a>
  </div>
</nav>

<style>
  .nav-store-btn:hover {
    background: #6E1E22;
    color: #F4EDE0 !important;
  }
</style>
