---
// How it works: the deal, the commitment, the binder. Three printed rules
// cards on the table, the way a premium deck explains itself in the box.
import ZCard from './ZCard.astro';

const steps = [
  {
    numeral: 'I',
    title: 'The deal',
    body: 'Every morning the deck deals you five cards. Each one is a small, real thing to do today: five minutes outside, fifty pages of a book, a plate that is half greens.',
  },
  {
    numeral: 'II',
    title: 'Commit',
    body: 'Pick the cards you can handle and leave the rest. Two a day on the free tier, all five on Pro. A light day still counts, as long as you finish what you picked.',
  },
  {
    numeral: 'III',
    title: 'Keep the card',
    body: 'Finish a card and it goes into your binder. Most are plain card stock, some carry a foil edge, and a few come in full gold. The binder fills one morning at a time.',
  },
];
---

<section id="how-it-works" class="section-pad">
  <div style="max-width:1040px;margin:0 auto;padding:0 1.5rem;text-align:center;">
    <p class="fade-in z-eyebrow">How it works</p>
    <h2 class="fade-in" style="font-size:clamp(1.8rem,5vw,2.75rem);line-height:1.12;color:#2B211B;margin:0 0 1rem;">
      Draw five. <em>Keep what you finish.</em>
    </h2>
    <p class="fade-in" style="font-family:'Cormorant Garamond',Georgia,serif;font-size:1.25rem;line-height:1.55;color:#3E342B;max-width:560px;margin:0 auto 2.75rem;">
      You could play it with a real deck on your kitchen table. The app just shuffles, deals and keeps score.
    </p>

    <div class="steps">
      {steps.map((s, i) => (
        <div class="fade-in z-stock step">
          <div class="step-art" aria-hidden="true">
            {i === 0 && (
              <div class="mini-deal">
                <ZCard back width="58px" style="transform:rotate(-10deg) translateX(18px);" />
                <ZCard back width="58px" style="transform:rotate(-2deg);" />
                <ZCard back width="58px" style="transform:rotate(7deg) translateX(-18px);" />
              </div>
            )}
            {i === 1 && <ZCard suit="mind" title="Long Read" width="78px" />}
            {i === 2 && <ZCard suit="physical" title="Open Air" finish="foil" width="78px" />}
          </div>
          <p class="step-num">{s.numeral}</p>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    text-align: center;
  }
  @media (max-width: 800px) {
    .steps { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
  .step {
    padding: 1.75rem 1.5rem 1.9rem;
  }
  .step-art {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }
  .mini-deal {
    display: flex;
  }
  .step-num {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    color: #7E6224;
    margin: 0 0 0.3rem;
  }
  .step-title {
    font-size: 1.35rem;
    color: #2B211B;
    margin: 0 0 0.6rem;
  }
  .step-body {
    font-weight: 300;
    font-size: 0.98rem;
    line-height: 1.7;
    color: #574B40;
    margin: 0;
  }
</style>
