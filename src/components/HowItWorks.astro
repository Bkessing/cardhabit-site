---
import { CATEGORY_COLORS } from '../lib/cardTheme';

const slots = ['Physical', 'Mental', 'Nutrition', 'Recovery', 'Wildcard'] as const;

const steps = [
  {
    numeral: 'I',
    title: 'Draw',
    body: 'Five cards at dawn, drawn at random from Physical, Mental, Nutrition, Recovery, Wildcard. The deal is calibrated to you: the stronger you get, the harder the cards run.',
  },
  {
    numeral: 'II',
    title: 'Commit',
    body: 'Pick your hand. The ones you choose are yours alone: locked in, untouchable by anyone, including your friends.',
  },
  {
    numeral: 'III',
    title: 'Complete',
    body: 'Hold the card for a second and a half and it\'s done. Finishing it earns you a vault card, currency you can spend on a friend\'s draw. The harder the challenge, the rarer the vault card.',
  },
  {
    numeral: 'IV',
    title: 'Tomorrow',
    body: 'Overnight, a friend may have spent a vault card on your next draw to make it harder, or better. Whatever lands in front of you, you do it anyway. That\'s the practice.',
  },
];
---

<section style="padding:5rem 0;">
  <div style="max-width:780px;margin:0 auto;padding:0 1.5rem;">

    <!-- Eyebrow -->
    <p class="fade-in" style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#A84D30;margin:0 0 1.25rem;text-align:center;">
      The ritual
    </p>

    <!-- H2 -->
    <h2 class="fade-in" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2rem,6vw,3rem);line-height:1.08;letter-spacing:-0.01em;color:#2E2115;margin:0 0 3rem;text-align:center;">
      The daily <em style="color:#A84D30;font-style:italic;">ritual.</em>
    </h2>

    <!-- 1.3: the quest board. Five cards at dawn, pinned to a wood-framed
         parchment board — the place this all happens, not just a list of
         steps. -->
    <div class="fade-in quest-board-outer warm-shadow-lg" role="img" aria-label="The quest board: five pinned card slots, one for each category">
      <div class="quest-board-inner">
        <div class="quest-board-slots">
          {slots.map((name) => (
            <div class="quest-slot" style={`--slot-color:${CATEGORY_COLORS[name]};`}>
              <span class="quest-slot-pin" aria-hidden="true"></span>
              <span class="quest-slot-label">{name}</span>
            </div>
          ))}
        </div>
        <p class="quest-board-caption">You commit to the hand you can handle.</p>
      </div>
    </div>

    <!-- Steps -->
    <div style="max-width:620px;margin:0 auto;">
      {steps.map((step, i) => (
        <div
          class="fade-in"
          style={`display:flex;gap:2rem;align-items:flex-start;padding:2rem 0;${i > 0 ? 'border-top:0.5px solid rgba(199, 91, 57, 0.18);' : ''}`}
        >
          <!-- Roman numeral -->
          <div style="min-width:50px;font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-size:2.25rem;line-height:1;color:#A84D30;padding-top:2px;">
            {step.numeral}
          </div>

          <!-- Content -->
          <div>
            <h3 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:1.5rem;color:#2E2115;margin:0 0 0.5rem;">
              {step.title}
            </h3>
            <p style="font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:0.98rem;line-height:1.7;color:#766449;margin:0;">
              {step.body}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Wood-frame border: base gradient plus a repeating faint-line overlay
     for grain, per 1.3. */
  .quest-board-outer {
    max-width: 620px;
    margin: 0 auto 3.5rem;
    padding: 14px;
    border-radius: 18px;
    background:
      repeating-linear-gradient(
        100deg,
        rgba(58, 36, 18, 0.1) 0px,
        rgba(58, 36, 18, 0.1) 1px,
        transparent 1px,
        transparent 7px
      ),
      linear-gradient(135deg, #C89A62 0%, #A87B48 55%, #7E5A32 100%);
  }

  .quest-board-inner {
    background: #FDF7EA;
    border: 1px solid rgba(126, 90, 50, 0.35);
    border-radius: 10px;
    padding: 2.25rem 1.5rem 1.75rem;
  }

  .quest-board-slots {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .quest-slot {
    position: relative;
    width: 84px;
    height: 118px;
    border: 1.5px dashed var(--slot-color);
    border-radius: 8px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8px;
    opacity: 0.9;
  }

  .quest-slot-pin {
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #C75B39;
    box-shadow: 0 1px 2px rgba(58, 36, 18, 0.4);
  }

  .quest-slot-label {
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slot-color);
    text-align: center;
    padding: 0 4px;
  }

  .quest-board-caption {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #A84D30;
    text-align: center;
    margin: 1.5rem 0 0;
  }

  @media (max-width: 560px) {
    .quest-slot {
      width: 30%;
      height: 96px;
    }
  }
</style>
