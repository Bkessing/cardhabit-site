---
import { CATEGORY_COLORS } from '../lib/cardTheme';

// 1.4: class treatment. Each archetype gets its category color (matching
// the app's category hues 1:1) and a simple line-work sigil. Copy is
// unchanged from the prior version.
const archetypes = [
  {
    numeral: 'I',
    name: 'Ironclad',
    category: 'Physical · Discipline',
    motto: 'Strength through repetition.',
    color: CATEGORY_COLORS.Physical,
    sigil: 'shield',
  },
  {
    numeral: 'II',
    name: 'Sage',
    category: 'Mental · Clarity',
    motto: 'Knowledge as power.',
    color: CATEGORY_COLORS.Mental,
    sigil: 'book',
  },
  {
    numeral: 'III',
    name: 'Alchemist',
    category: 'Nutrition · Balance',
    motto: 'Transformation through intention.',
    color: CATEGORY_COLORS.Nutrition,
    sigil: 'flask',
  },
  {
    numeral: 'IV',
    name: 'Phantom',
    category: 'Recovery · Silence',
    motto: 'Rest is not weakness.',
    color: CATEGORY_COLORS.Recovery,
    sigil: 'crescent',
  },
] as const;

// Clean line-work sigils, 24x24, stroke = currentColor. No kitsch.
const sigilPaths: Record<string, string> = {
  shield: '<path d="M12 3l7 3v5.2c0 4.6-3 8.4-7 9.8-4-1.4-7-5.2-7-9.8V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
  book: '<path d="M12 6.5c-1.8-1-4.6-1-6.5-.3v12c1.9-.7 4.7-.7 6.5.3 1.8-1 4.6-1 6.5-.3v-12c-1.9-.7-4.7-.7-6.5.3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 6.5v12" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  flask: '<path d="M10 3h4M10.5 3v5.2L6.3 16a1.4 1.4 0 0 0 1.2 2.1h9a1.4 1.4 0 0 0 1.2-2.1L13.5 8.2V3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/><path d="M8.6 13.5h6.8" fill="none" stroke="currentColor" stroke-width="1.2"/>',
  crescent: '<path d="M15.5 4.5A7.5 7.5 0 1 0 15.5 19.5 9 9 0 0 1 15.5 4.5z" fill="currentColor" stroke="none"/>',
};

const sigils: Record<string, string> = Object.fromEntries(
  Object.entries(sigilPaths).map(([key, inner]) => [
    key,
    `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">${inner}</svg>`,
  ])
);
---

<section class="section-pad">
  <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;">
  <!-- Eyebrow -->
  <p class="fade-in" style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#A84D30;margin:0 0 1.25rem;text-align:center;">
    The paths
  </p>

  <!-- H2 -->
  <h2 class="fade-in" style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2rem,6vw,3rem);line-height:1.08;letter-spacing:-0.01em;color:#2E2115;margin:0 0 1.5rem;text-align:center;">
    Four archetypes. <em style="color:#A84D30;font-style:italic;">Earn yours.</em>
  </h2>

  <!-- Lede -->
  <p class="fade-in" style="font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:1rem;line-height:1.7;color:#766449;max-width:580px;margin:0 auto 3rem;text-align:center;">
    An archetype is the play style you earn: the first ten cards you complete decide which one you become. You don't pick it, and each path rewards a different way of being, unlocking abilities that bend your daily draws toward what makes you stronger.
  </p>

  <!-- Grid -->
  <div class="arch-grid">
    {archetypes.map((arch) => (
      <div class="fade-in archetype-card arch-card warm-shadow" style={`--class-color:${arch.color};`}>
        <div class="arch-sigil" set:html={sigils[arch.sigil]} />

        <!-- Numeral -->
        <p class="arch-numeral">
          {arch.numeral}
        </p>

        <!-- Name -->
        <h3 class="arch-name">
          {arch.name}
        </h3>

        <!-- Category -->
        <p class="arch-category">
          {arch.category}
        </p>

        <!-- Motto -->
        <p class="arch-motto">
          "{arch.motto}"
        </p>
      </div>
    ))}
  </div>
  </div>
</section>

<style>
  .arch-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  .arch-card {
    flex: 1 1 260px;
    max-width: calc(25% - 11px);
    box-sizing: border-box;
    background: #FDF7EA;
    border: 0.5px solid rgba(199, 91, 57, 0.18);
    border-top: 4px solid var(--class-color);
    border-radius: 8px;
    padding: 1.5rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  @media (max-width: 900px) {
    .arch-card {
      max-width: calc(50% - 7px);
    }
  }

  @media (max-width: 560px) {
    .arch-card {
      max-width: 100%;
      flex-basis: 100%;
    }
  }

  .archetype-card:hover {
    border-color: rgba(199, 91, 57, 0.35);
    border-top-color: var(--class-color);
    transform: translateY(-2px);
  }

  .arch-sigil {
    width: 26px;
    height: 26px;
    color: var(--class-color);
    margin-bottom: 0.85rem;
  }

  .arch-sigil :global(svg) {
    width: 100%;
    height: 100%;
  }

  .arch-numeral {
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #75654D;
    margin: 0 0 0.75rem;
  }

  .arch-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 1.75rem;
    color: var(--class-color);
    margin: 0 0 0.4rem;
    line-height: 1.1;
  }

  .arch-category {
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #75654D;
    margin: 0 0 1rem;
  }

  .arch-motto {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: #766449;
    margin: 0;
    line-height: 1.5;
  }
</style>
