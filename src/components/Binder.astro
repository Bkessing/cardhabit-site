---
// The binder: the collection every finished card goes into (the Codex in the
// app). Shown as the physical object, not an app screen.
---

<section id="binder" class="section-pad">
  <div class="binder-wrap">
    <div class="binder-copy">
      <p class="fade-in z-eyebrow">The binder</p>
      <h2 class="fade-in" style="font-size:clamp(1.8rem,5vw,2.75rem);line-height:1.12;color:#2B211B;margin:0 0 1.25rem;">
        Every finished card <em>has a place.</em>
      </h2>
      <p class="fade-in binder-p">
        Each card you finish goes into your binder, sorted by suit. The empty sleeves show you what the deck still holds, and the full pages show you what you have actually done, morning after morning.
      </p>
      <p class="fade-in binder-stat">
        Your strongest suit &nbsp;<span>Mind, 42 cards</span>
      </p>
    </div>
    <div class="fade-in binder-art">
      <img src="/z/binder.webp" alt="An open card binder on a linen table, its sleeves filling with illustrated cards from every suit." width="1400" height="933" loading="lazy" decoding="async" class="warm-shadow-lg" />
    </div>
  </div>
</section>

<style>
  .binder-wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3rem;
    align-items: center;
  }
  .binder-p {
    font-weight: 300;
    font-size: 1.02rem;
    line-height: 1.75;
    color: #574B40;
    margin: 0 0 1.5rem;
  }
  .binder-stat {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #645749;
    border-top: 1px solid rgba(176, 138, 62, 0.5);
    border-bottom: 1px solid rgba(176, 138, 62, 0.5);
    padding: 0.7rem 0.2rem;
    margin: 0;
  }
  .binder-stat span {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: none;
    color: #2C4A7A;
  }
  .binder-art img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
  }
  @media (max-width: 800px) {
    .binder-wrap { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
  }
</style>
