---
// Hero: today's hand of five look Z cards fanned on the linen table, with the
// identity line (decided 2026-11-10) and the canonical entity sentence,
// verbatim (brain Locked.md). Real card titles from the live deck.
import ZCard from './ZCard.astro';

const STORE_URL = 'https://apps.apple.com/us/app/cardhabit-tcg-habit-tracker/id6768107296';

const hand = [
  { suit: 'physical', title: 'Open Air', finish: 'plain', done: true },
  { suit: 'physical', title: 'Iron Discipline', finish: 'foil', plate: '/z/plate-kettlebell.webp' },
  { suit: 'mind', title: 'The Deep Read', finish: 'gold' },
  { suit: 'nutrition', title: 'Green Plate', finish: 'plain' },
  { suit: 'recovery', title: 'Still Water', finish: 'plain' },
] as const;
---

<section class="z-linen hero">
  <div class="hero-inner">
    <p class="fade-in z-eyebrow">CardHabit &nbsp;·&nbsp; for iPhone</p>

    <h1 class="fade-in hero-h1">A daily card draw <em>for your life.</em></h1>

    <p class="fade-in hero-sub">
      CardHabit is an iOS daily challenge app built on trading-card-game mechanics: every morning it deals you five habit cards, and you commit to what you can handle that day.
    </p>

    <div class="fade-in hero-ctas">
      <a href={STORE_URL} class="z-btn" data-appstore-cta="hero">Download on the App Store</a>
      <a href="#printed-deck" class="z-btn z-btn--ghost">Get the printed deck</a>
    </div>

    <p class="fade-in hero-note">Free to start &nbsp;·&nbsp; The new deck arrives in the app with CardHabit 2.0</p>
  </div>

  <div class="fade-in hand" role="img" aria-label="Today's hand: five cards fanned on a linen table. Open Air, finished. Iron Discipline, The Deep Read, Green Plate and Still Water.">
    {hand.map((c, i) => (
      <div class="hand-slot" style={`--i:${i - 2};`}>
        <ZCard suit={c.suit} title={c.title} finish={c.finish} done={'done' in c && c.done} plate={'plate' in c ? c.plate : undefined} width="var(--cw)" />
      </div>
    ))}
    <div class="deck-stack" aria-hidden="true">
      <ZCard back width="var(--cw)" style="position:absolute;top:6px;left:4px;" />
      <ZCard back width="var(--cw)" style="position:absolute;top:3px;left:2px;" />
      <ZCard back width="var(--cw)" style="position:relative;" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 4rem 1.5rem 4.5rem;
    border-bottom: 1px solid rgba(176, 138, 62, 0.3);
  }

  .hero-inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hero-h1 {
    font-size: clamp(2.1rem, 6.4vw, 4rem);
    line-height: 1.08;
    color: #2B211B;
    margin: 0 0 1.4rem;
  }
  .hero-h1 em {
    display: block;
  }

  .hero-sub {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.5;
    color: #3E342B;
    max-width: 620px;
    margin: 0 auto 2rem;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-note {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #645749;
    margin: 1.25rem 0 0;
  }

  /* The hand: five cards fanned from a pivot below the row, with the deck's
     card back stacked to the right like a dealt table. */
  .hand {
    --cw: 168px;
    position: relative;
    height: calc(var(--cw) * 1.62);
    max-width: 1000px;
    margin: 3rem auto 0;
  }
  .hand-slot {
    position: absolute;
    left: 50%;
    top: 0;
    margin-left: calc(var(--cw) / -2 - var(--cw) * 0.45);
    transform-origin: 50% 160%;
    transform: translateX(calc(var(--i) * var(--cw) * 0.78)) rotate(calc(var(--i) * 6deg)) translateY(calc(var(--i) * var(--i) * 4px));
  }
  .deck-stack {
    position: absolute;
    left: 50%;
    top: calc(var(--cw) * 0.12);
    margin-left: calc(var(--cw) * 2.05);
    transform: rotate(8deg);
  }

  @media (max-width: 900px) {
    .hand { --cw: 132px; }
    .hand-slot { margin-left: calc(var(--cw) / -2); }
    .deck-stack { display: none; }
  }
  @media (max-width: 560px) {
    .hero { padding: 2.75rem 1.25rem 3rem; }
    .hand { --cw: 86px; height: calc(var(--cw) * 1.85); margin-top: 2rem; }
    .hand-slot {
      transform: translateX(calc(var(--i) * var(--cw) * 0.6)) rotate(calc(var(--i) * 6deg)) translateY(calc(var(--i) * var(--i) * 3px));
    }
  }
</style>
