---
// Live App Store screens (en-US 6.7", version 1.2.2), pulled from App Store
// Connect on 2026-10-25 so the site matches the app people download. They
// are the store's own composites (headline + device frame), so no extra
// bezel is drawn around them. Swap back to in-app captures when the rebrand
// ships (see Bkessing/hq#36).
import { Image } from 'astro:assets';
import draw from '../assets/screenshots/store-01-draw.png';
import legendary from '../assets/screenshots/store-02-legendary.png';
import codex from '../assets/screenshots/store-03-codex.png';

const shots = [
  { src: draw, alt: "Today's Draw: five daily challenge cards, from Common to Legendary", rot: -4, z: 1 },
  { src: legendary, alt: 'A Legendary Wildcard, "No Exceptions," reaching Gold mastery', rot: 0, z: 2 },
  { src: codex, alt: 'The Codex: completed cards collected by category, 15 of 25 done', rot: 4, z: 1 },
];
---

<section style="padding:0 1.5rem;">
  <div style="max-width:900px;margin:0 auto;text-align:center;">
    <div class="device-row fade-in">
      {shots.map((shot) => (
        <div class="device-frame" style={`--rot:${shot.rot}deg;--z:${shot.z};`}>
          <div class="device-bezel warm-shadow-lg">
            <Image src={shot.src} alt={shot.alt} width={600} format="webp" quality={78} loading="lazy" />
          </div>
        </div>
      ))}
    </div>
    <p class="device-caption">
      Straight from the app. No mockups.
    </p>
  </div>
</section>

<style>
  .device-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: -18px;
    margin: 0 auto;
  }

  .device-frame {
    position: relative;
    flex: 0 0 auto;
    width: 30%;
    max-width: 210px;
    transform: rotate(var(--rot));
    z-index: var(--z);
    margin: 0 -18px;
    transition: transform 0.25s ease;
  }

  .device-frame:hover {
    transform: rotate(var(--rot)) translateY(-6px);
  }

  .device-bezel {
    border-radius: 18px;
    overflow: hidden;
    line-height: 0;
  }

  .device-bezel :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .device-caption {
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #75654D;
    margin: 2rem 0 0;
  }

  @media (max-width: 640px) {
    .device-row {
      gap: 0;
    }
    .device-frame {
      width: 34%;
      margin: 0 -14px;
    }
  }
</style>
