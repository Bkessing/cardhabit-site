---
import { storeLink } from '../lib/storeLink';

interface Props {
  source?: string;
}

const { source = 'section' } = Astro.props;

const STORE_URL = storeLink('cardhabit-site');
---

<section
  id="download"
  class="section-pad" style="padding-left:1.5rem;padding-right:1.5rem;text-align:center;"
>
  <!-- Closing banner: the oxblood card back with its gold foil double rule,
       reserved for this closing conversion moment. -->
  <div class="stitched-banner-outer">
    <div class="stitched-banner-inner">
      <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:500;letter-spacing:0.28em;text-transform:uppercase;color:#D9BC74;opacity:1;margin:0 0 1.25rem;">
        Available now
      </p>

      <!-- H2 -->
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(2.2rem,6.5vw,3.25rem);line-height:1.05;letter-spacing:-0.01em;color:#F4EDE0;margin:0 0 1.5rem;">
        Your first hand is <em style="color:#D9BC74 !important;">waiting.</em>
      </h2>

      <!-- Lede -->
      <p style="font-family:'Jost',system-ui,sans-serif;font-weight:300;font-size:1rem;line-height:1.65;color:#F8F3E8;opacity:0.9;max-width:480px;margin:0 auto 2.5rem;">
        CardHabit is live on the iOS App Store. Free to start. Founder pricing on Pro is live in the app, $4.99 a month or $39.99 a year with a 7-day free trial, locked in at signup.
      </p>

      <!-- CTA -->
      <a
        href={STORE_URL}
        class="store-cta"
        data-appstore-cta={source}
        style="display:inline-block;background:#F8F3E8;color:#561418;font-family:'Jost',system-ui,sans-serif;font-weight:500;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;padding:1rem 2.25rem;border-radius:3px;text-decoration:none;transition:background 0.2s,transform 0.2s;"
      >
        Download on the App Store
      </a>

      <p style="font-family:'Jost',system-ui,sans-serif;font-size:10px;font-weight:400;letter-spacing:0.1em;text-transform:uppercase;color:#F8F3E8;opacity:0.7;margin:1.25rem 0 0;">
        iOS 18 and later &nbsp;·&nbsp; Free to download
      </p>
    </div>
  </div>
</section>

<style>
  .stitched-banner-outer {
    max-width: 720px;
    margin: 0 auto;
    background: #6E1E22;
    background-image: radial-gradient(ellipse 80% 70% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%);
    border-radius: 14px;
    padding: 10px;
    box-shadow: 0 2px 6px rgba(43, 33, 27, 0.18), 0 24px 54px rgba(43, 33, 27, 0.14);
  }

  .stitched-banner-inner {
    border: 1px solid rgba(217, 188, 116, 0.75);
    outline: 1px solid rgba(217, 188, 116, 0.45);
    outline-offset: -6px;
    border-radius: 8px;
    padding: 3.25rem 2rem;
  }

  .store-cta:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
  }
</style>
