{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cardhabitapp.com"
        }
      ],
      "destination": "https://cardhabitapp.com/:path*",
      "permanent": true
    },
    {
      "source": "/tiktok",
      "destination": "/?src=tiktok",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?src=instagram",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?src=x",
      "permanent": false
    },
    {
      "source": "/pin",
      "destination": "/?src=pinterest",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/invite/:code",
      "destination": "/invite"
    }
  ]
}
